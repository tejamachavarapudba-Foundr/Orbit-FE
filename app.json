{
  "expo": {
    "name": "Orbit",
    "newArchEnabled": false,
    "slug": "startuphouze",
    "version": "1.0.0",
    "jsEngine": "hermes",
    "orientation": "portrait",
    "scheme": "startuphouze",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#3b82f6"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/dc4b1e6d-bc45-48df-9fc0-78ad433edfa5"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "androidNavigationBar": {
      "backgroundColor": "#3b82f6",
      "barStyle": "light-content"
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#3b82f6"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.startuphouze.app"
    },
    "android": {
      "package": "com.startuphouze.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3b82f6"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAWJv4lpGac1PDXGHvS0IhsiHIxkJ7ZORw"
        }
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-asset",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/feather.ttf",
            "./assets/fonts/ionicons.ttf"
          ]
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Orbit to access your photos to attach them to posts.",
          "videosPermission": "Allow Orbit to access your videos to attach them to posts.",
          "cameraPermission": "Allow Orbit to access your camera to take a profile photo."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "dc4b1e6d-bc45-48df-9fc0-78ad433edfa5"
      }
    }
  }
}
